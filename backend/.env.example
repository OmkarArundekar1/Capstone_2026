# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# MISP - Threat Intelligence Platform
MISP_URL=https://localhost:8443
MISP_API_KEY=

# ========== HYBRID THREAT ENRICHMENT (Replaces Shuffle) ==========
# VirusTotal API (Optional but recommended for IP reputation)
# Get your key from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB API (Optional but recommended for abuse reports)
# Get your key from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Enhanced Detection System Configuration
# Auto-enrich attackers with threat intelligence (true/false)
AUTO_ENRICH_ATTACKERS=true

# Auto-execute safe actions without approval (true/false)
AUTO_EXECUTE_SAFE_ACTIONS=true

# Dry-run mode for testing (simulates actions without executing)
DETECTION_DRY_RUN=false

# Enrichment cache time-to-live in seconds (default: 3600 = 1 hour)
ENRICHMENT_CACHE_TTL=3600
# ========== END HYBRID THREAT ENRICHMENT ==========

# Wazuh
WAZUH_ALERT_FILE=/var/ossec/logs/alerts/alerts.json

# GNN Model (Optional - for graph neural network features)
GNN_ENABLED=false

# Active Containment (Optional - automated blocking)
AUTO_CONTAIN=false
CONTAINMENT_NEVER_BLOCK_IPS=

# Event Time Policy (processing_time_fallback or strict)
EVENT_TIME_POLICY=processing_time_fallback
